{
  // Cloudflare Workers configuration for trainingslog
  //
  // Setup:
  // 1. Copy this file to wrangler.jsonc
  // 2. Create the D1 database:
  //      npx wrangler d1 create trainingslog
  // 3. Replace YOUR_D1_DATABASE_ID below with the id printed by step 2
  // 4. Initialize the schema:
  //      npx wrangler d1 execute trainingslog --remote --file=schema.sql
  // 5. (Optional) Import existing data:
  //      npx wrangler d1 execute trainingslog --remote --file=local/trainingslog-d1-import.sql
  // 6. Deploy: npm run deploy:cloudflare

  "name": "trainingslog",
  "main": ".open-next/worker.js",
  "compatibility_date": "2024-12-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "trainingslog",
      "database_id": "YOUR_D1_DATABASE_ID"
    }
  ]
}
